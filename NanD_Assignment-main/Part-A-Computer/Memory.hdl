// Memory map: RAM16K (0..16383), Screen (16384..24575), Keyboard (24576).
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=ramSelect);
    And(a=address[14], b=address[13], out=keyboardSelect);
    Not(in=address[13], out=notAddress13);
    And(a=address[14], b=notAddress13, out=screenSelect);

    And(a=load, b=ramSelect, out=loadRam);
    And(a=load, b=screenSelect, out=loadScreen);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    Mux16(a=ramOut, b=screenOut, sel=address[14], out=ramOrScreen);
    Mux16(a=ramOrScreen, b=keyboardOut, sel=keyboardSelect, out=out);
}
